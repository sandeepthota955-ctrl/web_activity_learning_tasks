<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Personal Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            background-color: #f4f7fc;
            color: #222;
            line-height: 1.6;
        }

        header {
            background-color: #14213d;
            color: white;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        header h2 {
            color: #00d4ff;
        }

        nav {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #00d4ff;
        }

        .hero {
            min-height: 85vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 50px 20px;
            background: linear-gradient(135deg, #14213d, #2455a4);
            color: white;
        }

        .hero-content {
            animation: fadeIn 1.5s ease;
        }

        .profile-image {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            border: 5px solid #00d4ff;
            object-fit: cover;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: 42px;
            margin-bottom: 10px;
        }

        .hero h1 span {
            color: #00d4ff;
        }

        .hero p {
            font-size: 18px;
            margin-bottom: 25px;
        }

        .button {
            display: inline-block;
            padding: 12px 25px;
            margin: 5px;
            background-color: #00d4ff;
            color: #14213d;
            text-decoration: none;
            border-radius: 25px;
            font-weight: bold;
            transition: 0.3s;
        }

        .button:hover {
            background-color: white;
            transform: translateY(-4px);
        }

        section {
            padding: 65px 8%;
            scroll-margin-top: 85px;
        }

        .section-title {
            text-align: center;
            font-size: 30px;
            color: #14213d;
            margin-bottom: 35px;
        }

        .section-title::after {
            content: "";
            display: block;
            width: 70px;
            height: 4px;
            background-color: #00a8cc;
            margin: 10px auto;
            border-radius: 5px;
        }

        .about {
            background-color: white;
            text-align: center;
        }

        .about p {
            max-width: 800px;
            margin: auto;
            font-size: 17px;
        }

        .education,
        .hobbies,
        .achievements {
            background-color: #f4f7fc;
        }

        .card-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 25px;
        }

        .card {
            background-color: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .card h3 {
            color: #2455a4;
            margin-bottom: 10px;
        }

        .skills,
        .projects,
        .contact {
            background-color: white;
        }

        .skill-list {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        .skill {
            background-color: #e1f7ff;
            color: #14213d;
            padding: 12px 25px;
            border-radius: 25px;
            border: 1px solid #00bde8;
            transition: 0.3s;
        }

        .skill:hover {
            background-color: #14213d;
            color: white;
            transform: scale(1.08);
        }

        .project-card {
            border-top: 4px solid #00bde8;
        }

        .resume {
            background: linear-gradient(135deg, #14213d, #2455a4);
            color: white;
            text-align: center;
        }

        .resume .section-title {
            color: white;
        }

        .contact {
            text-align: center;
        }

        .contact p {
            margin: 12px 0;
            font-size: 17px;
        }

        .contact a {
            color: #2455a4;
            text-decoration: none;
        }

        .contact a:hover {
            text-decoration: underline;
        }

        footer {
            background-color: #14213d;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            header {
                justify-content: center;
                text-align: center;
            }

            nav {
                justify-content: center;
            }

            .hero h1 {
                font-size: 32px;
            }

            .hero p {
                font-size: 16px;
            }

            section {
                padding: 45px 5%;
            }
        }

        @media (max-width: 480px) {
            nav {
                gap: 10px;
            }

            nav a {
                font-size: 13px;
            }

            .hero h1 {
                font-size: 27px;
            }

            .section-title {
                font-size: 25px;
            }
        }
    </style>
</head>

