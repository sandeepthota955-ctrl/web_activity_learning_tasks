<div class="container" id="timeline">

    <h2>PROJECT TIMELINE</h2>

    <div class="timeline">

        <div class="stage">
            <h3>Week 1 - Planning</h3>
            <p>Identify community problems and prepare the project plan.</p>
        </div>

        <div class="stage">
            <h3>Week 2 - Awareness</h3>
            <p>Conduct awareness programs for local people.</p>
        </div>

        <div class="stage">
            <h3>Week 3 - Implementation</h3>
            <p>Organize cleaning and tree plantation activities.</p>
        </div>

        <div class="stage">
            <h3>Week 4 - Evaluation</h3>
            <p>Collect feedback and evaluate project results.</p>
        </div>

    </div>
</div>

<div class="container" id="gallery">

    <h2>PROJECT PHOTO GALLERY</h2>

    <div class="cards">

        <div class="card">
