<!DOCTYPE html>
<html>
<head>
    <title>Community Service Project</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background-color: #f4f8f6;
            color: #333;
        }

        header {
            background: linear-gradient(120deg, #00695c, #43a047);
            color: white;
            text-align: center;
            padding: 35px;
        }

        header h1 {
            font-size: 35px;
        }

        nav {
            background-color: #004d40;
            padding: 18px;
            text-align: center;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 12px;
            font-weight: bold;
        }

        nav a:hover {
            color: yellow;
        }

        .hero {
            background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
            url("https://images.unsplash.com/photo-1559027615-cd4628902d4a");
            background-size: cover;
            background-position: center;
            color: white;
            text-align: center;
            padding: 110px 20px;
        }

        .hero h2 {
            font-size: 40px;
        }

        .container {
            width: 90%;
            margin: auto;
            padding: 30px 0;
        }

        h2 {
            text-align: center;
            color: #008577;
            margin-bottom: 30px;
        }

        .cards {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .card {
            background: white;
            width: 260px;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 3px 10px #ccc;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card h3 {
            color: #008577;
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 10px;
        }

        .timeline {
            background: white;
            padding: 25px;
            border-radius: 10px;
            box-shadow: 0 3px 10px #ccc;
        }

        .stage {
            background: #e0f2f1;
            border-left: 5px solid #008577;
            padding: 15px;
            margin: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
        }

        th, td {
            padding: 15px;
            border: 1px solid #ccc;
            text-align: center;
        }

        th {
            background: #008577;
            color: white;
        }

        tr:nth-child(even) {
            background: #e0f2f1;
        }

        .report {
            background: white;
            padding: 20px;
            margin: 15px 0;
            border-radius: 10px;
            box-shadow: 0 2px 8px #ccc;
        }

        .outcomes {
            background: #e0f2f1;
            padding: 30px;
            border-radius: 10px;
            text-align: center;
        }

        footer {
            background: #004d40;
            color: white;
            text-align: center;
            padding: 25px;
            margin-top: 30px;
        }

        @media(max-width: 600px) {
            .cards {
                flex-direction: column;
                align-items: center;
            }

            nav a {
                display: inline-block;
                margin: 7px;
            }

            .hero h2 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body>

<header>
    <h1>COMMUNITY SERVICE PROJECT</h1>
    <p>Serving Society | Building a Better Future</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#objectives">Objectives</a>
    <a href="#beneficiaries">Beneficiaries</a>
    <a href="#volunteers">Volunteers</a>
    <a href="#timeline">Timeline</a>
    <a href="#gallery">Gallery</a>
    <a href="#reports">Reports</a>
    <a href="#outcomes">Outcomes</a>
</nav>

